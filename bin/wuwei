#!/bin/sh
plugin_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd) || exit 2
command -v python3 >/dev/null 2>&1 || { echo "wuwei: python3 not found" >&2; exit 2; }
[ -d "$plugin_root/cli/wuwei" ] || { echo "wuwei: cli not found under $plugin_root" >&2; exit 2; }
unset PYTHONEXECUTABLE
exec python3 -I -P -S -c 'import runpy, sys; sys.path[:0] = sys.argv[1:3]; del sys.argv[1:3]
try: runpy.run_module("wuwei", run_name="__main__", alter_sys=True)
except Exception as exc:  # a PreToolUse hook that fails before it can judge refuses: only exit 2 blocks the call
    if sys.argv[1:] != ["hook", "PreToolUse"]: raise
    sys.stderr.write(f"wuwei hook PreToolUse: {type(exc).__name__}: {exc}"[:300] + "\n"); sys.exit(2)' "$plugin_root/cli" "$plugin_root" "$@"
