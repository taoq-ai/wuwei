[Unit]
Description=WUWEI workspace @COMMAND@
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@WORKSPACE@
Environment="WUWEI_WORKSPACE=@WORKSPACE@"
Environment="PATH=@PATH@"
ExecStart="@PLUGIN_ROOT@/bin/wuwei" @COMMAND@
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
