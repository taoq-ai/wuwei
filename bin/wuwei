#!/bin/sh
plugin_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd) || exit 2
command -v python3 >/dev/null 2>&1 || { echo "wuwei: python3 not found" >&2; exit 2; }
[ -d "$plugin_root/cli/wuwei" ] || { echo "wuwei: cli not found under $plugin_root" >&2; exit 2; }
PYTHONPATH="$plugin_root/cli:$plugin_root${PYTHONPATH:+:$PYTHONPATH}" exec python3 -P -m wuwei "$@"
