[Unit]
Description=WUWEI workspace watch
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@WORKSPACE@
Environment="WUWEI_WORKSPACE=@WORKSPACE@"
Environment="PATH=@PATH@"
ExecStart=@PLUGIN_ROOT@/bin/wuwei watch
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
